# CodeForge configuration. Copy to .env.local for local runs (deployed runs read .env).
# Every key CodeForge reads is listed here; keep this file in sync when you add one.
# Never put real values in this file: it is committed.

# Identity comes only from config, never from what a user types.
CODEFORGE_USER_ID=u-dev
# student | instructor
CODEFORGE_ROLE=student

# SQLite file for Runs (relative to where you start CodeForge).
CODEFORGE_DB_PATH=codeforge.db

# Requests a User may submit per day (UTC). R1 demo User: 5, chaos-run User: 25.
CODEFORGE_RUN_QUOTA=5

# Your Groq API key. Leave blank here; set it in .env.local / .env.
GROQ_API_KEY=
