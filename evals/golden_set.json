    {
      "id": "H01-mask-secret",
      "tier": "hard",
      "area": "pii",
      "check": "mask",
      "text": "my groq key is {FAKE_GROQ_KEY} please help",
      "expect": {
        "masked": "my groq key is [SECRET] please help"
      }
    },
    {
      "id": "H02-mask-email",
      "tier": "hard",
      "area": "pii",
      "check": "mask",
