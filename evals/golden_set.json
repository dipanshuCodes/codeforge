    {
      "id": "H13-same-request-twice-runs-once",
      "tier": "hard",
      "area": "idempotency",
      "check": "graph",
      "graph": {
        "requests": [
          "Write a Python function that checks if a string is a palindrome.",
          "Write a Python function that checks if a string is a palindrome."
        ],
        "real_sandbox": true,
        "model": {
          "requirements": {
            "function_name": "is_palindrome",
            "description": "Palindrome check.",
            "params": [
              {
                "name": "s",
                "type": "str"
              }
            ],
            "returns": "bool",
            "edge_cases": []
          },
          "code": "def is_palindrome(s):\n    return s == s[::-1]\n",
          "tests": "from solution import is_palindrome\n\ndef test_yes():\n    assert is_palindrome('aba')\n\ndef test_no():\n    assert not is_palindrome('ab')\n"
        }
      },
      "expect": {
        "outcomes": [
          "tests_passed",
          "tests_passed"
        ],
        "sandbox_runs": 1,
        "model_calls": 5,
        "duplicate": true,
        "report_contains": [
          "Duplicate Request"
        ]
      }
    },
